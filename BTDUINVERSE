<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BTD UNIVERSE - Hub Oficial</title>
    <style>
        /* REGRAS PRESERVADAS DO SEU DESIGN ORIGINAL */
        :root {
            --bg: #0a0a0c;
            --ink: #f5f5f7;
            --cyan: #00f0ff;
            --purple: #7000ff;
            --gold: #ffd166;
            --sans: 'Rajdhani', sans-serif;
            --serif: 'Cormorant Garamond', Georgia, serif;
            --mono: 'Space Mono', monospace;
        }
        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--sans);
            font-size: 16px;
            line-height: 1.7;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,212,255,0.008) 3px, rgba(0,212,255,0.008) 4px);
            pointer-events: none;
            z-index: 999;
        }

        /* HEADER E NAV COMPACTO */
        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 200;
            padding: 1.2rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(3,3,10,0.88);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .nav-logo {
            font-family: var(--mono);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--cyan);
            text-decoration: none;
        }
        .nav-links { display: flex; gap: 2.5rem; }
        .nav-links a {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--ink);
            text-decoration: none;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            transition: color 0.2s;
        }
        .nav-links a:hover { color: var(--cyan); }

        /* HERO & BANNER SOFISTICADO */
        .banner-hero {
            position: relative;
            min-height: 50vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 8rem 2rem 4rem;
            background: linear-gradient(180deg, rgba(112,0,255,0.15) 0%, rgba(10,10,12,1) 100%), url('btdbanner.png') center/cover no-repeat;
            border-bottom: 1px solid rgba(0,240,255,0.1);
        }
        .logo-container img {
            max-width: 180px;
            height: auto;
            filter: drop-shadow(0 0 15px rgba(0,240,255,0.4));
            margin-bottom: 1.5rem;
        }
        .banner-hero h1 {
            font-family: var(--serif);
            font-size: 3rem;
            font-weight: 300;
            letter-spacing: 0.05em;
            margin: 0;
            color: var(--ink);
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        }

        /* GRID E CONTEÚDO */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }
        .section-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            margin-bottom: 4rem;
        }
        @media (max-width: 768px) { .section-grid { grid-template-columns: 1fr; } }

        .card {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.05);
            padding: 2.5rem;
            border-radius: 4px;
            position: relative;
            transition: border 0.3s;
        }
        .card:hover { border-color: var(--cyan); }
        .card h2 {
            font-family: var(--serif);
            font-size: 1.8rem;
            margin-top: 0;
            color: var(--gold);
        }

        /* LINKS DOS STREAMINGS (BOTÕES) */
        .streaming-links {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .stream-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.8rem;
            font-family: var(--mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-decoration: none;
            border-radius: 4px;
            background: rgba(255,255,255,0.05);
            color: var(--ink);
            border: 1px solid transparent;
            transition: all 0.2s;
        }
        .stream-btn.spotify:hover { background: #1DB954; color: #000; }
        .stream-btn.apple:hover { background: #FC3C44; color: #fff; }
        .stream-btn.amazon:hover { background: #00A8E1; color: #fff; }
        .stream-btn.youtube:hover { background: #FF0000; color: #fff; }

        /* PLAYER DE ÁUDIO OCULTO / AUTOMÁTICO */
        .audio-widget {
            margin-top: 1.5rem;
            background: rgba(0,240,255,0.05);
            border: 1px solid var(--cyan);
            padding: 1rem;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <nav>
        <a href="#" class="nav-logo">BTD UNIVERSE</a>
        <div class="nav-links">
            <a href="#narrativa">Narrativa</a>
            <a href="#trilha">Trilha Sonora</a>
        </div>
    </nav>

    <!-- BANNER PROFISSIONAL DE ALTO PADRÃO -->
    <header class="banner-hero">
        <div class="logo-container">
            <!-- Puxa automaticamente a logo do seu repositório -->
            <img src="btdlogo.png" alt="BTD Universe Logo">
        </div>
        <h1>Soberania Ancestral & Transmídia</h1>
    </header>

    <main class="container">
        <div class="section-grid">
            
            <!-- NARRATIVA E O FIO TÊNUE -->
            <section id="narrativa" class="card">
                <h2>Códice Literário</h2>
                <p>Fundação narrativa baseada em subjetividade humana e fricção digital. Conheça a obra que ancora o ecossistema:</p>
                <a href="https://caravanagrupoeditorial.com.br" target="_blank" style="color: var(--cyan); text-decoration: none; font-weight: bold; letter-spacing: 0.05em;">
                    → Adquirir / Acessar "O Fio Tênue"
                </a>
            </section>

            <!-- TRILHA SONORA SADSTINK -->
            <section id="trilha" class="card">
                <h2>SadStink — Trilha Sonora Original</h2>
                <p>Álbuns <em>Museum of Lies</em> e <em>Ground Zero</em> integrados à experiência cênica internacional.</p>
                
                <!-- PLAYER AUTOMÁTICO - MUSEUM OF LIES -->
                <div class="audio-widget">
                    <span style="font-family: var(--mono); font-size: 11px; display: block; margin-bottom: 0.5rem; color: var(--cyan);">
                        🔊 Executando: Museum of Lies EP
                    </span>
                    <audio controls autoplay loop style="width: 100%;">
                        <source src="Museum_of_Lies.mp3" type="audio/mpeg">
                        Seu navegador não suporta o player nativo.
                    </audio>
                </div>

                <!-- LINKS EXTERNOS OFICIAIS -->
                <div class="streaming-links">
                    <a href="https://spotify.com" target="_blank" class="stream-btn spotify">Spotify</a>
                    <a href="https://apple.com" target="_blank" class="stream-btn apple">Apple Music</a>
                    <a href="https://amazon.com" target="_blank" class="stream-btn amazon">Amazon</a>
                    <a href="https://youtube.com" target="_blank" class="stream-btn youtube">YouTube</a>
                </div>
            </section>

        </div>
    </main>

</body>
</html>
